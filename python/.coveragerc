[run]
source = python
branch = True
omit =
    python/test_*.py
    python/tests/test_*.py
    python/tests/__init__.py
    python/__pycache__/*

[report]
fail_under = 80
show_missing = True
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    raise NotImplementedError

[html]
directory = python/htmlcov
